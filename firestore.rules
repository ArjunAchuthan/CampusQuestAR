rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection: authenticated users can check admin status
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Locations: Read-only
    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile and directory docs
    // - Read/list: public (for registration desk roster & leaderboards)
    // - Create: public (for registration desk & participant account init)
    // - Update/delete: public (for registration desk) or authenticated owner/admin
    match /users/{userId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Progress docs: public create & delete for registration desk, authenticated owner or admin read/write
    match /progress/{userId} {
      allow read, list: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Leaderboard entries: Public read & write/delete
    match /leaderboard/{entryId} {
      allow read, list: if true;
      allow write: if true;
    }
  }
}

